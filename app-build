#!/bin/sh
# One-command bootstrap. Never upgrades pip; install.sh respects enterprise Nexus.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$HERE"
COMMAND=${1:-}
# One command to update: stop this project's services, pull, then start the Web Console.
if [ "$COMMAND" = update ]; then
  shift
  "$HERE/app-build" stop || { echo '[UPDATE] 停止旧服务失败，未更新。' >&2; exit 1; }
  exec "$HERE/app-build" web --update "$@"
fi
# Explicit opt-in: update this tool only if its tracked worktree is clean.
if [ "$COMMAND" = run ] || [ "$COMMAND" = resume ] || [ "$COMMAND" = web ]; then
  DRY_RUN=0
  for arg in "$@"; do
    if [ "$arg" = --dry-run ]; then DRY_RUN=1; fi
  done
  if [ "$DRY_RUN" = 0 ]; then
  for arg in "$@"; do
    if [ "$arg" = --update ]; then
      if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo '[UPDATE] 当前目录不是 Git 工作区；无法自动更新。' >&2; exit 1
      fi
      if [ -n "$(git status --porcelain)" ]; then
        if [ "$COMMAND" = web ]; then
          echo '[UPDATE] 发现本地未提交的修改：跳过自动更新，继续启动当前 Web Console。'
          break
        fi
        echo '[UPDATE] 工作区存在未提交更改，拒绝自动更新。' >&2; exit 1
      fi
      echo '[UPDATE] git pull --ff-only（最多等待 30 秒）'
      # A Mac may be temporarily off VPN, or its Git credentials may be expired.
      # Failure to update the dashboard must not make the current version unusable.
      if python3 - <<'PY_GIT_UPDATE'
import os
import subprocess
import sys
try:
    result = subprocess.run(['git', 'pull', '--ff-only'], timeout=30, check=False,
                            env={**os.environ, 'GIT_TERMINAL_PROMPT': '0'})
    sys.exit(result.returncode)
except subprocess.TimeoutExpired:
    print('[UPDATE] GitHub 更新超时。')
    sys.exit(1)
PY_GIT_UPDATE
      then
        echo '[UPDATE] 更新完成。'
      elif [ "$COMMAND" = web ]; then
        echo '[UPDATE] 未能自动更新；继续启动当前版本（不覆盖本地修改）。'
      else
        echo '[UPDATE] 更新失败，已停止。' >&2; exit 1
      fi
      break
    fi
  done
  # Installer is run only if the isolated environment does not have deps.
  if [ ! -x .venv/bin/python ] || ! .venv/bin/python -c 'import playwright, yaml' >/dev/null 2>&1; then
    echo '[SETUP] 依赖缺失，自动执行 ./install.sh（使用现有公司 Nexus 配置）'
    ./install.sh
  else
    echo '[SETUP] 项目依赖已安装，跳过 install.sh'
  fi
  fi
fi
if [ -x .venv/bin/python ]; then
  exec .venv/bin/python -m appbuilder "$@"
fi
exec python3 -m appbuilder "$@"
